<!doctype html>
<html class="no-js{% if settings.rtl %} body-rtl{% endif %}" lang="{{ request.locale.iso_code }}">
  <head>
    <meta name="google-site-verification" content="OCYluzAcFSmIG_J2W1jY6tmQmHb3wq46RFVk00TA_0s" />
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {%- liquid
      assign seo_description = page_description
      if template.name == 'index'
        assign seo_description = 'Shop BestPrintsCo vegan made-to-order shoes, boots, sneakers, hooded blankets, bedding, car accessories, bags, and giftable printed designs.'
      elsif template.name == 'list-collections'
        assign seo_description = 'Explore BestPrintsCo collections by product family, including printed footwear, apparel, home decor, bedding, car accessories, bags, and giftable designs.'
      elsif template.name == '404'
        assign seo_description = 'The page could not be found. Continue shopping BestPrintsCo collections for printed footwear, apparel, home decor, car accessories, bags, and gifts.'
      elsif template.name == 'search'
        assign seo_description = 'Search BestPrintsCo for printed footwear, apparel, home decor, car accessories, bags, and giftable designs.'
      elsif template.name == 'page' and page.handle == 'about-us'
        assign seo_description = 'Learn about BestPrintsCo and shop printed footwear, apparel, home decor, car accessories, bags, and giftable designs by product family.'
      elsif template.name == 'page' and page.handle == 'contact'
        assign seo_description = 'Contact BestPrintsCo for product, order, return, and policy questions before or after ordering.'
      elsif template.name == 'collection' and collection != blank
        case collection.handle
          when 'vegan-leather-boots'
            assign seo_description = 'Shop BestPrintsCo vegan made-to-order boot designs with bold artwork, lace-up styling, size options, product images, and related footwear collections.'
          when 'running-shoes'
            assign seo_description = 'Explore BestPrintsCo vegan made-to-order running shoes and sneakers with breathable mesh-style listings, artwork-led designs, options, and pricing.'
          when 'high-top-shoes'
            assign seo_description = 'Browse BestPrintsCo vegan made-to-order high-top shoe designs with canvas-style listings, double-sided artwork, size options, and related footwear collections.'
          when 'footwear'
            assign seo_description = 'Shop BestPrintsCo footwear by silhouette, including vegan leather boots, running shoes, high-top shoes, slippers, and printed styles.'
          when 'slippers-flip-flops'
            assign seo_description = 'Browse relaxed footwear styles such as slippers and flip-flops from the BestPrintsCo catalog.'
          when 'car-seat-covers'
            assign seo_description = 'Shop BestPrintsCo printed car seat cover designs, compare two-front-seat-cover listings, artwork, options, and car accessory collections.'
          when 'car-accessories'
            assign seo_description = 'Explore BestPrintsCo car accessories, including car seat cover and interior accessory designs for coordinated style browsing.'
          when 'bedding-sets'
            assign seo_description = 'Shop BestPrintsCo printed bedding set designs with duvet-cover and pillow-case listings for bedroom refreshes and gift browsing.'
          when 'hooded-blankets'
            assign seo_description = 'Browse BestPrintsCo hooded blanket designs with cozy printed styles for lounging, movie nights, reading, and gift shopping.'
          when 'blankets'
            assign seo_description = 'Explore printed blanket designs from BestPrintsCo for home decor, gifting, and theme-led browsing.'
          when 'beach-blankets'
            assign seo_description = 'Shop beach blanket designs from BestPrintsCo for outdoor, travel, and gift-oriented browsing.'
          when 'all-home-products'
            assign seo_description = 'Browse BestPrintsCo home products across bedding, blankets, wall decor, and related home-gift collections.'
          when 'wall-tapestry'
            assign seo_description = 'Explore printed wall tapestry designs from BestPrintsCo for room decor, dorm decor, and gift discovery.'
          when 'hoodies'
            assign seo_description = 'Shop printed hoodie designs from BestPrintsCo and compare artwork, color, available sizes, and related apparel collections.'
          when 'womens-hoodie-dresses'
            assign seo_description = 'Browse women’s hoodie dress designs from BestPrintsCo for statement apparel and gift discovery.'
          when 't-shirts'
            assign seo_description = 'Explore printed T-shirt designs from BestPrintsCo with artwork-led product cards and related apparel navigation.'
          when 'kids-clothing'
            assign seo_description = 'Browse kids clothing designs from BestPrintsCo for gift shopping and family-friendly motif discovery.'
          when 'bags'
            assign seo_description = 'Shop printed bag designs from BestPrintsCo, including giftable styles and motif-led accessories.'
        endcase
      endif
    -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    <meta name="description" content="{{ seo_description | default: shop.description | default: shop.name | escape }}">
    {% render 'meta-tags', seo_description: seo_description %}
    {{ content_for_header }}
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
    {%- render 'head-assets' -%}
  </head>
  <body class="{% if template.name == 'collection' %}template-collection{% endif %}{% if template.name == 'product' %}template-product {% endif %}{% if template.name == 'index' %}template-index{% endif %} {%- if settings.general_layout == 'boxed' -%}box-layout{% elsif settings.general_layout == 'full_width' %}full-width-layout{% else %}{%- endif -%} {% if settings.content_center %}item-center{% endif %} product-images-style-{{ settings.product_images_style }}">
    <div class="bls-wrapper">
      <div class="bls__overlay d-none-overlay"></div>
      {% section 'announcement' %}
      {%- render 'header' -%}
      <main
        id="MainContent"
        class="content-for-layout focus-none{% if template == 'product' or template == 'page.wishlist' or template == "page.recently-viewed-products" %} skeleton-product-detail{% endif %}"
        role="main"
        tabindex="-1"
      >
        {{ content_for_layout }}
      </main>
      {%- render 'footer-layout' -%}
      {%- section 'mobile-stickybar' -%}
      {%- section 'custom-colors' -%}
    </div>
    {%- render 'fake-order' -%}
    {%- render 'content-bottom' -%}
    {%- render 'before-you-leave' -%}
    {%- render 'scripts-tag' -%}
    {%- if shop.domain == 'umino-demo.myshopify.com' or shop.domain == 'demo-umino.myshopify.com' -%}
      <feature-button class="d-none extent-button-right-bar"></feature-button>
    {%- endif -%}
  <!-- PF EDT START -->
<script type='text/javascript'>
{%- if content_for_header contains 'shopify-product-customizer' -%}
    {%- if product -%}
        {%- if product.first_available_variant -%}
            var pfProductId = {{ product.metafields.printful.is_synced | json }};
            var pfEdt = {{ shop.metafields.printful.is_edt_enabled | json }};
            var pfEdtTextColor = {{ shop.metafields.printful.edt_text_color | json }};
            var pfEdtBackgroundColor = {{ shop.metafields.printful.edt_background_color | json }};
            var pfEdtBorderColor = {{ shop.metafields.printful.edt_border_color | json }};  
            var pfEdtUseDefaultStyling = {{ shop.metafields.printful.edt_default_style | json }};
            var pfEdtTextAlignment = {{ shop.metafields.printful.edt_text_alignment | json }};
            var pfEdtFlags = {
                US: "{{ 'US.svg' | asset_url }}",CA: "{{ 'CA.svg' | asset_url }}",ES: "{{ 'ES.svg' | asset_url }}",LV: "{{ 'LV.svg' | asset_url }}",GB: "{{ 'GB.svg' | asset_url }}",DE: "{{ 'DE.svg' | asset_url }}",FR: "{{ 'FR.svg' | asset_url }}",AU: "{{ 'AU.svg' | asset_url }}",JP: "{{ 'JP.svg' | asset_url }}",NZ: "{{ 'NZ.svg' | asset_url }}",IT: "{{ 'IT.svg' | asset_url }}",BR: "{{ 'BR.svg' | asset_url }}",KR: "{{ 'KR.svg' | asset_url }}",NL: "{{ 'NL.svg' | asset_url }}",GB: "{{ 'GB.svg' | asset_url }}",US: "{{ 'US.svg' | asset_url }}",
            };
        {%- else -%}
            var pfEdt = 0;
        {%- endif -%}
    {%- endif -%}
{%- endif -%}
</script>
<!-- PF EDT END -->
</body>
</html>
