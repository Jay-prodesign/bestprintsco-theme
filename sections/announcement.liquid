{{ 'bpc-brand-system.css' | asset_url | stylesheet_tag }}
{% liquid
  assign show = section.settings.show_announcement
  if section.settings.homepage_only and request.page_type != 'index'
    assign show = false
  endif
%}
{% if show %}
  <section id="announcement-bar" class="announcement-bar" style="--announcement-bar-bg:{{ section.settings.bar_background_color }};--announcement-bar-color:{{ section.settings.bar_text_color }}">
    <div class="{{ section.settings.container }}">
      {% for block in section.blocks %}
        {% if block.settings.text != blank %}<div class="announcement-bar-content text-center py-10 px-15" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name":"Announcement Bar",
  "class":"announcement_bar",
  "settings":[
    {"type":"select","id":"container","label":"Layout","default":"container","options":[{"value":"container","label":"Default"},{"value":"container-fluid","label":"Fluid container"},{"value":"full-width","label":"Full width"}]},
    {"type":"checkbox","id":"show_announcement","label":"Show announcement","default":false},
    {"type":"checkbox","id":"homepage_only","label":"Home page only","default":true},
    {"type":"color","id":"bar_background_color","label":"Background color","default":"#3a2030"},
    {"type":"color","id":"bar_text_color","label":"Text color","default":"#ffffff"}
  ],
  "max_blocks":4,
  "blocks":[{"type":"announcement","name":"Announcement","settings":[{"type":"richtext","id":"text","default":"<p>Welcome to BestPrintsCo</p>","label":"Text"}]}],
  "default":{"blocks":[{"type":"announcement"}]}
}
{% endschema %}