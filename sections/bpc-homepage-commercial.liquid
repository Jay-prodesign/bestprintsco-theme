{% liquid
assign elephant = collections['elephant-designs-gifts']
assign boots = collections['vegan-leather-boots']
assign bedding = collections['bedding-sets']
assign products = 'vegan-leather-boots|running-shoes|bags|bedding-sets|all-home-products|car-accessories' | split: '|'
assign designs = 'elephant-designs-gifts|dragonfly-designs-gifts|skull-dark-art-designs|hippie-peace-tie-dye-designs|floral-botanical-designs' | split: '|'
%}
<section class="bpc" data-bpc-homepage-v2>
  <div class="bpc-hero">
    <div class="bpc-wrap bpc-hero-grid">
      <div class="bpc-hero-copy">
        <p class="bpc-kicker">Art for every part of your world</p>
        <h1>Discover printed designs that feel unmistakably you.</h1>
        <p>Explore expressive artwork across boots, shoes, bags, home pieces and car accessories. Start with the product you need—or the design you already love.</p>
        <div class="bpc-actions">
          <a class="bpc-button bpc-button-light" href="/collections/elephant-designs-gifts">Explore design worlds</a>
          <a class="bpc-button bpc-button-line" href="/collections/vegan-leather-boots">Shop printed boots</a>
        </div>
        <div class="bpc-quick"><a href="/collections/running-shoes">Printed shoes</a><a href="/collections/bedding-sets">Bedding</a><a href="/collections/bags">Bags</a><a href="/collections/car-accessories">Car accessories</a></div>
      </div>
      <div class="bpc-collage">
        <a class="bpc-tile bpc-tile-main" href="{{ elephant.url }}">
          {% if elephant.image %}{{ elephant.image | image_url: width: 1500 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '700,1000,1500', sizes: '(min-width:990px) 50vw,100vw', alt: 'Elephant designs and gifts' }}{% elsif elephant.products.first.featured_image %}{{ elephant.products.first.featured_image | image_url: width: 1500 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '700,1000,1500', sizes: '(min-width:990px) 50vw,100vw', alt: elephant.products.first.title }}{% endif %}
          <span><small>Featured design world</small><strong>Elephant designs</strong><em>Explore collection →</em></span>
        </a>
        <a class="bpc-tile" href="{{ boots.url }}">
          {% if boots.image %}{{ boots.image | image_url: width: 800 | image_tag: loading: 'eager', widths: '420,600,800', sizes: '(min-width:990px) 22vw,45vw', alt: 'Printed boots collection' }}{% elsif boots.products.first.featured_image %}{{ boots.products.first.featured_image | image_url: width: 800 | image_tag: loading: 'eager', widths: '420,600,800', sizes: '(min-width:990px) 22vw,45vw', alt: boots.products.first.title }}{% endif %}<span><strong>Printed boots</strong></span>
        </a>
        <a class="bpc-tile" href="{{ bedding.url }}">
          {% if bedding.image %}{{ bedding.image | image_url: width: 800 | image_tag: loading: 'eager', widths: '420,600,800', sizes: '(min-width:990px) 22vw,45vw', alt: 'Printed bedding collection' }}{% elsif bedding.products.first.featured_image %}{{ bedding.products.first.featured_image | image_url: width: 800 | image_tag: loading: 'eager', widths: '420,600,800', sizes: '(min-width:990px) 22vw,45vw', alt: bedding.products.first.title }}{% endif %}<span><strong>Printed home</strong></span>
        </a>
      </div>
    </div>
  </div>

  <nav class="bpc-help" aria-label="Customer help"><div class="bpc-wrap"><a href="/pages/contact-us"><b>Need help?</b><small>Contact our team</small></a><a href="/pages/track-order"><b>Track an order</b><small>View order progress</small></a><a href="/policies/shipping-policy"><b>Shipping details</b><small>Read the current policy</small></a><a href="/policies/refund-policy"><b>Refund policy</b><small>Review before ordering</small></a></div></nav>

  <div class="bpc-dark"><div class="bpc-wrap bpc-section">
    <header class="bpc-heading bpc-heading-split"><div><p class="bpc-kicker">Choose your world</p><h2>Start with the artwork you love.</h2></div><p>Explore focused design worlds without searching through the entire catalog.</p></header>
    <div class="bpc-designs">
      {% for handle in designs %}{% assign c = collections[handle] %}{% if c != blank %}
        <a class="bpc-design{% if forloop.first %} bpc-design-featured{% endif %}" href="{{ c.url }}">
          {% if c.image %}{{ c.image | image_url: width: 1300 | image_tag: loading: 'lazy', widths: '420,700,1000,1300', sizes: '(min-width:990px) 32vw,50vw', alt: c.title }}{% elsif c.products.first.featured_image %}{{ c.products.first.featured_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '420,700,1000', sizes: '(min-width:990px) 32vw,50vw', alt: c.products.first.title }}{% endif %}
          <span><small>Design world</small><strong>{{ c.title }}</strong><em>Explore designs →</em></span>
        </a>
      {% endif %}{% endfor %}
    </div>
  </div></div>

  <div class="bpc-wrap bpc-section">
    <header class="bpc-heading bpc-heading-center"><p class="bpc-kicker">Know what you need?</p><h2>Shop by product.</h2><p>Move directly into a focused product collection, then narrow the artwork.</p></header>
    <div class="bpc-products">
      {% for handle in products %}{% assign c = collections[handle] %}{% if c != blank %}
        <a class="bpc-product" href="{{ c.url }}"><div>{% if c.image %}{{ c.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,600,900', sizes: '(min-width:990px) 16vw,50vw', alt: c.title }}{% elsif c.products.first.featured_image %}{{ c.products.first.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,600,900', sizes: '(min-width:990px) 16vw,50vw', alt: c.products.first.title }}{% endif %}</div><span><strong>{{ c.title }}</strong><small>Shop collection →</small></span></a>
      {% endif %}{% endfor %}
    </div>
  </div>

  <div class="bpc-wrap bpc-stories">
    <a class="bpc-story" href="/blogs/guides/unique-printed-gift-ideas">{% if elephant.image %}{{ elephant.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width:990px) 50vw,100vw', alt: 'Unique printed gift ideas' }}{% endif %}<span><small>Gift ideas</small><strong>Find gifts through the designs they already love.</strong><em>Explore the gift guide →</em></span></a>
    <a class="bpc-story" href="/blogs/guides/printed-boots-style-guide">{% if boots.image %}{{ boots.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width:990px) 50vw,100vw', alt: 'Printed boots style guide' }}{% elsif boots.products.first.featured_image %}{{ boots.products.first.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width:990px) 50vw,100vw', alt: boots.products.first.title }}{% endif %}<span><small>Style guide</small><strong>Choose printed boots with more confidence.</strong><em>Read the guide →</em></span></a>
  </div>

  <div class="bpc-wrap bpc-seo"><p class="bpc-kicker">Two simple ways to explore</p><h2>Browse by product. Discover by design.</h2><p>BestPrintsCo brings printed boots, shoes, bags, bedding, home décor and car accessories into a clearer discovery system. Shop by product when you know what you need, or enter a design world when the artwork comes first.</p><div><a href="/collections/vegan-leather-boots">Printed boots</a><a href="/collections/running-shoes">Printed shoes</a><a href="/collections/bedding-sets">Printed bedding</a><a href="/collections/car-accessories">Car accessories</a><a href="/collections/all">All products</a></div></div>
</section>
<style>
.bpc{--ink:#181318;--cream:#f7f3ee;--wine:#641a45;--gold:#c39a5b;background:var(--cream);color:var(--ink);overflow:hidden}.bpc *{box-sizing:border-box}.bpc-wrap{width:min(1280px,calc(100% - 40px));margin:auto}.bpc-kicker{margin:0;color:#b77a9c;font-size:12px;font-weight:800;letter-spacing:.17em;text-transform:uppercase}.bpc-hero{padding:42px 0;background:radial-gradient(circle at 90% 5%,#6b354b,transparent 30%),linear-gradient(135deg,#151015,#371428);color:#fff}.bpc-hero-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:52px;align-items:center;min-height:680px}.bpc-hero-copy h1{margin:14px 0 22px;font-size:clamp(46px,5.5vw,78px);line-height:.98;letter-spacing:-.05em}.bpc-hero-copy>p:last-of-type{max-width:620px;color:#d6cbd1;font-size:20px;line-height:1.6}.bpc-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.bpc-button{display:inline-flex;min-height:53px;padding:0 24px;align-items:center;border-radius:99px;font-weight:800;text-decoration:none}.bpc-button-light{background:#fff;color:#49142f}.bpc-button-line{border:1px solid #ffffff99;color:#fff}.bpc-quick{display:flex;gap:17px;flex-wrap:wrap;margin-top:25px}.bpc-quick a{color:#d8cdd2;font-size:14px;font-weight:700}.bpc-collage{display:grid;grid-template-columns:1.22fr .78fr;grid-template-rows:1fr 1fr;gap:13px;height:580px}.bpc-tile{position:relative;overflow:hidden;border-radius:25px;color:#fff;box-shadow:0 25px 70px #0006}.bpc-tile-main{grid-row:1/3}.bpc-tile img,.bpc-design img,.bpc-story img{width:100%;height:100%;object-fit:cover;transition:.45s}.bpc-tile:after,.bpc-design:after,.bpc-story:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#120b10e8,transparent 65%)}.bpc-tile span,.bpc-design span,.bpc-story span{position:absolute;z-index:2;left:22px;right:22px;bottom:21px}.bpc-tile small,.bpc-tile strong,.bpc-tile em,.bpc-design small,.bpc-design strong,.bpc-design em,.bpc-story small,.bpc-story strong,.bpc-story em{display:block}.bpc-tile strong{font-size:21px}.bpc-tile-main strong{font-size:28px}.bpc-tile small,.bpc-design small,.bpc-story small{color:#e8c797;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.bpc-tile em,.bpc-design em,.bpc-story em{margin-top:7px;color:#ddd1d7;font-size:12px;font-style:normal;font-weight:700}.bpc-help{background:#fff;border-bottom:1px solid #e5dbd4}.bpc-help>div{display:grid;grid-template-columns:repeat(4,1fr)}.bpc-help a{padding:21px;color:var(--ink);text-decoration:none;border-right:1px solid #e5dbd4}.bpc-help a:last-child{border:0}.bpc-help b,.bpc-help small{display:block}.bpc-help small{margin-top:4px;color:#776c75}.bpc-section{padding:92px 0}.bpc-dark{background:#21171f;color:#fff}.bpc-heading h2,.bpc-seo h2{margin:9px 0;font-size:clamp(35px,4.4vw,57px);line-height:1.02;letter-spacing:-.04em}.bpc-heading-split{display:grid;grid-template-columns:1fr .7fr;gap:50px;align-items:end;margin-bottom:35px}.bpc-heading-split>p{color:#cfc3ca;line-height:1.6}.bpc-heading-center{max-width:760px;margin:0 auto 34px;text-align:center}.bpc-heading-center>p:last-child,.bpc-seo>p{color:#5d535b;font-size:17px;line-height:1.65}.bpc-designs{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:290px;gap:14px}.bpc-design{position:relative;overflow:hidden;border-radius:21px;color:#fff}.bpc-design-featured{grid-column:span 2;grid-row:span 2}.bpc-design strong{font-size:23px}.bpc-design-featured strong{font-size:38px}.bpc-products{display:grid;grid-template-columns:repeat(6,1fr);gap:13px}.bpc-product{overflow:hidden;border:1px solid #e3d8d1;border-radius:17px;background:#fff;color:var(--ink);text-decoration:none}.bpc-product>div{aspect-ratio:4/5;overflow:hidden}.bpc-product img{width:100%;height:100%;object-fit:cover;transition:.4s}.bpc-product span{display:block;padding:16px}.bpc-product strong,.bpc-product small{display:block}.bpc-product small{margin-top:6px;color:var(--wine);font-weight:800}.bpc-product:hover img,.bpc-tile:hover img,.bpc-design:hover img,.bpc-story:hover img{transform:scale(1.045)}.bpc-stories{display:grid;grid-template-columns:1fr 1fr;gap:17px;padding-bottom:92px}.bpc-story{position:relative;min-height:560px;overflow:hidden;border-radius:25px;color:#fff}.bpc-story strong{font-size:clamp(30px,3.5vw,48px);line-height:1.04}.bpc-seo{max-width:900px;padding:0 0 92px;text-align:center}.bpc-seo>div{display:flex;justify-content:center;gap:9px;flex-wrap:wrap;margin-top:22px}.bpc-seo a{padding:9px 14px;border:1px solid #d9ccc3;border-radius:99px;background:#fff;color:var(--wine);text-decoration:none;font-weight:800}
@media(max-width:1050px){.bpc-hero-grid{grid-template-columns:1fr}.bpc-collage{height:550px}.bpc-products{grid-template-columns:repeat(3,1fr)}.bpc-designs{grid-template-columns:repeat(3,1fr)}}
@media(max-width:700px){.bpc-wrap{width:calc(100% - 24px)}.bpc-hero-copy h1{font-size:43px}.bpc-actions{display:grid}.bpc-button{width:100%;justify-content:center}.bpc-collage{height:450px;gap:8px}.bpc-tile{border-radius:17px}.bpc-tile span{left:14px;bottom:14px}.bpc-tile-main strong{font-size:21px}.bpc-tile small,.bpc-tile em{display:none}.bpc-help>div{grid-template-columns:1fr 1fr}.bpc-help a{padding:16px 11px}.bpc-section{padding:66px 0}.bpc-heading-split{grid-template-columns:1fr;gap:12px}.bpc-designs{grid-template-columns:1fr 1fr;grid-auto-rows:230px;gap:8px}.bpc-design-featured{grid-column:span 2;grid-row:span 1}.bpc-design strong,.bpc-design-featured strong{font-size:18px}.bpc-design span{left:13px;bottom:13px}.bpc-products{grid-template-columns:1fr 1fr;gap:8px}.bpc-product span{padding:12px}.bpc-stories{grid-template-columns:1fr;padding-bottom:66px}.bpc-story{min-height:480px}.bpc-story strong{font-size:32px}.bpc-story span{left:20px;bottom:20px}.bpc-seo{padding-bottom:68px}}
@media(prefers-reduced-motion:reduce){.bpc *{transition:none!important}}
</style>
