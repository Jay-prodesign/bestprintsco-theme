{%- liquid
  assign th_st = settings
  assign show_my_account = th_st.show_my_account
  assign source_menu = linklists['main-menu-1']
  assign shop_link = blank
  assign designs_link = blank
  for link in source_menu.links
    if link.title == 'Shop by Product'
      assign shop_link = link
    elsif link.title == 'Shop by Design'
      assign designs_link = link
    endif
  endfor
-%}
<nav class="navigation horizontal main-nav nav-sections bls__canvas-mb-menu bls__canvas-mb-left bpc-primary-nav" data-width-sub-center="800">
  <div class="close-menu-mobile absolute">
    <a href="#" class="close-menu">{{ 'main_menu.horizontal.close' | t }} <i class="icon-x"></i></a>
  </div>
  <div class="mobile-menu-content">
    <div class="menu-mobile-title fw-600">
      <a class="active" data-menu="horizontal-list" href="#">Menu</a>
    </div>
    <ul class="horizontal-list menu p-0 list-none my-0 up_to_down">
      {%- if shop_link != blank -%}
        <li class="level0 bls__menu-parent default_dropdown">
          <a class="relative" href="/collections"><span>Shop</span></a>
          <div class="open-children-toggle"></div>
          <div class="submenu absolute"><ul class="dropdown p-0 list-none my-0">
            {%- render 'bpc-menu-branch', links: shop_link.links, level: 1 -%}
            <li class="relative level-1 bpc-menu-view-all"><a href="/collections/all" class="site-nav level-1"><span>View all products</span></a></li>
          </ul></div>
        </li>
      {%- endif -%}
      {%- if designs_link != blank -%}
        <li class="level0 bls__menu-parent default_dropdown">
          <a class="relative" href="/collections"><span>Designs</span></a>
          <div class="open-children-toggle"></div>
          <div class="submenu absolute"><ul class="dropdown p-0 list-none my-0">
            {%- render 'bpc-menu-branch', links: designs_link.links, level: 1 -%}
          </ul></div>
        </li>
      {%- endif -%}
      <li class="level0 bls__menu-parent default_dropdown">
        <a class="relative" href="/blogs/guides/unique-printed-gift-ideas"><span>Gifts</span></a>
        <div class="open-children-toggle"></div>
        <div class="submenu absolute"><ul class="dropdown p-0 list-none my-0">
          <li class="relative level-1"><a href="/collections/elephant-designs-gifts" class="site-nav level-1"><span>Elephant gifts</span></a></li>
          <li class="relative level-1"><a href="/collections/dragonfly-designs-gifts" class="site-nav level-1"><span>Dragonfly gifts</span></a></li>
          <li class="relative level-1"><a href="/collections/floral-botanical-designs" class="site-nav level-1"><span>Floral gift ideas</span></a></li>
          <li class="relative level-1"><a href="/blogs/guides/unique-printed-gift-ideas" class="site-nav level-1"><span>Unique printed gift ideas</span></a></li>
        </ul></div>
      </li>
      <li class="level0 bls__menu-parent default_dropdown">
        <a class="relative" href="/blogs/guides"><span>Guides</span></a>
        <div class="open-children-toggle"></div>
        <div class="submenu absolute"><ul class="dropdown p-0 list-none my-0">
          <li class="relative level-1"><a href="/blogs/guides/printed-boots-style-guide" class="site-nav level-1"><span>Printed boots style guide</span></a></li>
          <li class="relative level-1"><a href="/blogs/guides/unique-printed-gift-ideas" class="site-nav level-1"><span>Unique printed gift ideas</span></a></li>
          <li class="relative level-1 bpc-menu-view-all"><a href="/blogs/guides" class="site-nav level-1"><span>View all guides</span></a></li>
        </ul></div>
      </li>
      <li class="level0 bls__menu-parent default_dropdown">
        <a class="relative" href="/pages/about-us"><span>Help</span></a>
        <div class="open-children-toggle"></div>
        <div class="submenu absolute"><ul class="dropdown p-0 list-none my-0">
          {%- render 'menu-dropdown', handle_menu: 'about' -%}
        </ul></div>
      </li>
    </ul>
    {%- if show_my_account -%}
      <div class="bls__customer-accounts px-25 text-center pb-30 mt-auto">
        <div class="accounts">
          {% if customer %}
            <a href="{{ routes.account_url }}" class="account-url btn-primary mb-10"><span class="px-10">{{ customer.first_name }}</span></a>
            <a href="{{ routes.account_logout_url }}" class="account-logout btn-secondary">{{ 'customer.log_out' | t }}</a>
          {% else %}
            <a href="{{ routes.account_login_url }}" class="account-login btn-primary mb-10">{{ 'customer.log_in' | t }}</a>
            <a href="{{ routes.account_register_url }}" class="account-register btn-secondary">{{ 'customer.register.title' | t }}</a>
          {% endif %}
        </div>
      </div>
    {%- endif -%}
  </div>
</nav>
<style>
  .bpc-primary-nav .horizontal-list>li>a{font-weight:650;letter-spacing:.01em;padding-left:18px;padding-right:18px}.bpc-primary-nav .submenu{border-radius:0 0 14px 14px;box-shadow:0 18px 45px rgba(34,18,28,.14);border:1px solid rgba(83,42,66,.1)}.bpc-primary-nav .dropdown>li>a{min-width:240px}.bpc-primary-nav .bpc-menu-view-all>a{color:#7a2858;font-weight:750;border-top:1px solid #eadfe5}.bpc-primary-nav .submenu a:hover{color:#8f416b}@media(max-width:1199px){.bpc-primary-nav .horizontal-list>li>a{padding-left:12px;padding-right:12px}.bpc-primary-nav .submenu{border-radius:0;box-shadow:none}.bpc-primary-nav .dropdown>li>a{min-width:0}}
</style>
{% schema %}
{
  "name":"BestPrintsCo main menu",
  "tag":"section",
  "class":"bls_main_menu",
  "settings":[
    {"type":"select","id":"m_animation","label":"Dropdown animation","default":"up_to_down","options":[{"value":"fading","label":"Fading"},{"value":"down_to_up","label":"Down to up"},{"value":"up_to_down","label":"Up to down"}]},
    {"type":"number","id":"width_sub_menu_center","label":"Submenu center width","default":800}
  ],
  "presets":[{"name":"BestPrintsCo main menu"}]
}
{% endschema %}
