{%- liquid
  assign design_handles = 'elephant-designs-gifts,dragonfly-designs-gifts,skull-dark-art-designs,hippie-peace-tie-dye-designs,floral-botanical-designs' | split: ','
  assign matched_design = blank
  for product_collection in product.collections
    if design_handles contains product_collection.handle
      assign matched_design = product_collection
      break
    endif
  endfor
  assign product_links = 'vegan-leather-boots|Printed Boots,running-shoes|Shoes,bags|Bags,bedding-sets|Bedding,all-home-products|Home,car-accessories|Car' | split: ','
-%}
<section class="bpc-product-discovery" aria-label="Continue exploring">
  <div class="container">
    <div class="bpc-product-discovery__panel">
      <div class="bpc-product-discovery__intro">
        <span class="bpc-product-discovery__kicker">Continue exploring</span>
        <h2>{% if matched_design != blank %}Love this artwork?{% else %}Find more distinctive designs{% endif %}</h2>
        <p>{% if matched_design != blank %}Explore more products from the {{ matched_design.title }} collection, or browse the catalog by product type.{% else %}Browse BestPrintsCo by product type and discover related artwork across the catalog.{% endif %}</p>
        {% if matched_design != blank %}
          <a class="bpc-product-discovery__feature" href="{{ matched_design.url }}">
            {%- assign feature_image = matched_design.image | default: matched_design.products.first.featured_image -%}
            {% if feature_image != blank %}<span class="bpc-product-discovery__feature-image">{{ feature_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '210,420', alt: matched_design.title }}</span>{% endif %}
            <span><strong>Explore {{ matched_design.title }}</strong><small>See the complete design world →</small></span>
          </a>
        {% endif %}
      </div>
      <div class="bpc-product-discovery__browse">
        <h3>Shop by product</h3>
        <div class="bpc-product-discovery__track" role="list">
          {% for item in product_links %}
            {% assign parts = item | split: '|' %}
            {% assign target = collections[parts[0]] %}
            {% if target != blank %}
              {% assign image = target.image | default: target.products.first.featured_image %}
              <a role="listitem" class="bpc-product-discovery__card" href="{{ target.url }}">
                <span class="bpc-product-discovery__image">{% if image != blank %}{{ image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,180', alt: parts[1] }}{% endif %}</span>
                <span>{{ parts[1] }}</span>
              </a>
            {% endif %}
          {% endfor %}
        </div>
        <div class="bpc-product-discovery__links">
          <a href="/blogs/guides/unique-printed-gift-ideas">Gift ideas</a>
          <a href="/blogs/guides/printed-boots-style-guide">Printed boots guide</a>
          <a href="/collections/all">View all products</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
.bpc-product-discovery{padding:42px 0;background:#f7f3ee}.bpc-product-discovery__panel{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.3fr);gap:42px;padding:34px;border:1px solid #eadfe5;border-radius:20px;background:#fffdfb}.bpc-product-discovery__kicker{display:block;color:#8f416b;font-size:12px;font-weight:750;letter-spacing:.12em;text-transform:uppercase}.bpc-product-discovery h2{margin:7px 0 10px;color:#3a2030;font-size:34px;line-height:1.12}.bpc-product-discovery p{margin:0 0 20px;color:#695765;line-height:1.65}.bpc-product-discovery__feature{display:flex;align-items:center;gap:14px;padding:12px;border:1px solid #eadfe5;border-radius:14px;color:#3a2030}.bpc-product-discovery__feature-image{width:82px;height:82px;overflow:hidden;border-radius:11px;background:#f3ecef}.bpc-product-discovery__feature-image img,.bpc-product-discovery__image img{width:100%;height:100%;object-fit:cover}.bpc-product-discovery__feature strong,.bpc-product-discovery__feature small{display:block}.bpc-product-discovery__feature small{margin-top:4px;color:#8f416b}.bpc-product-discovery__browse h3{margin:0 0 14px;color:#3a2030;font-size:20px}.bpc-product-discovery__track{display:flex;gap:14px;overflow-x:auto;padding:2px 2px 10px;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch}.bpc-product-discovery__card{flex:0 0 96px;text-align:center;color:#3a2030;font-size:13px;font-weight:650;scroll-snap-align:start}.bpc-product-discovery__image{display:block;width:76px;height:76px;margin:0 auto 8px;border-radius:50%;overflow:hidden;background:#f3ecef;border:2px solid transparent;box-shadow:0 6px 18px rgba(58,32,48,.08);transition:.2s ease}.bpc-product-discovery__card:hover .bpc-product-discovery__image{transform:translateY(-2px);border-color:#c39a5b}.bpc-product-discovery__links{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}.bpc-product-discovery__links a{padding:9px 14px;border:1px solid #d8c5cf;border-radius:999px;color:#641a45;font-weight:650}.bpc-product-discovery__links a:hover{background:#641a45;color:#fff}.bpc-product-discovery__feature:focus-visible,.bpc-product-discovery__card:focus-visible,.bpc-product-discovery__links a:focus-visible{outline:2px solid #641a45;outline-offset:3px}@media(max-width:767px){.bpc-product-discovery{padding:28px 0}.bpc-product-discovery__panel{grid-template-columns:1fr;gap:28px;padding:22px;border-radius:16px}.bpc-product-discovery h2{font-size:27px}.bpc-product-discovery__track{margin-right:-22px;padding-right:22px}.bpc-product-discovery__feature-image{width:72px;height:72px}}
</style>
{% schema %}
{"name":"BPC product discovery","settings":[],"presets":[{"name":"BPC product discovery"}]}
{% endschema %}