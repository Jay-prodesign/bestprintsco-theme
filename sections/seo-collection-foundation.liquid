{%- if collection != blank -%}
  {%- liquid
    assign title = collection.title | escape
    assign intro = ''
    assign support = ''
    assign faq_1_q = 'How should I choose from this collection?'
    assign faq_1_a = 'Start with the product type, then compare the visible design, available options, product images, price, and policy links before ordering.'
    assign faq_2_q = 'Can I compare related BestPrintsCo collections?'
    assign faq_2_a = 'Yes. Use the related collection links below to move between nearby product families and matching gift ideas.'

    case collection.handle
      when 'vegan-leather-boots'
        assign intro = 'Shop vegan leather boot designs for bold outfits, statement gifts, and artwork-led footwear that stands out fast.'
        assign support = 'BestPrintsCo boot listings describe vegan, made-to-order construction, handcrafted finishing, double-sided print artwork, lace-up closure, rounded toe construction, textile lining, and a sturdy outsole. Compare the design, selected size, price, and product images before checkout. Orders usually ship in 5–7 business days.'
      when 'running-shoes'
        assign intro = 'Explore printed running shoe and sneaker designs for everyday outfits, colorful gifts, and artwork-forward footwear.'
        assign support = 'Representative BestPrintsCo sneaker listings describe vegan, made-to-order construction, handcrafted finishing, breathable mesh fabric, lace-up closure, and EVA sole construction. Use the product cards to compare the design, selected options, price, and product images before choosing. Orders usually ship in 5–7 business days.'
      when 'high-top-shoes'
        assign intro = 'Browse high-top shoe designs for bold outfits, collector-style artwork, and giftable printed footwear.'
        assign support = 'Representative BestPrintsCo high-top listings describe vegan, made-to-order canvas shoes with handcrafted finishing, double-sided artwork, rounded toe construction, lace-up closure, metal eyelets, textile lining, and lightweight outsole construction. Compare the right silhouette, selected size, and visible design before checkout.'
      when 'footwear'
        assign intro = 'Shop BestPrintsCo footwear by silhouette, from vegan leather boots to running shoes, high-top shoes, slippers, and other printed styles.'
        assign support = 'Start here when you want expressive footwear but still need to choose the right product family, size option, and design direction. Product pages surface the details that matter most: artwork, selected options, price, images, shipping policy, and return-policy links.'
      when 'slippers-flip-flops'
        assign intro = 'Browse relaxed slip-on footwear styles such as printed flip flops and easy warm-weather designs.'
        assign support = 'Representative BestPrintsCo flip-flop listings describe custom made-to-order construction, handcrafted finishing, lightweight EVA sole construction, water-resistant design, and vibrant canvas prints along the tops. Compare the artwork, size, product images, and price before ordering.'
      when 'car-seat-covers'
        assign intro = 'Shop printed car seat cover designs for drivers who want their car interior to feel more personal, colorful, and gift-worthy.'
        assign support = 'Representative BestPrintsCo listings describe a set of two front seat covers made to add style while helping protect seats from spills, stains, tearing, and fading. Review the product page before ordering and do not assume vehicle compatibility unless it is stated on that product.'
        assign faq_1_q = 'How do I check whether a car seat cover is right for me?'
        assign faq_1_a = 'Review the product images, selected options, and any visible product-page details before ordering. Do not assume vehicle compatibility unless it is stated on the product page.'
      when 'car-accessories'
        assign intro = 'Explore BestPrintsCo car accessories, including car-seat-cover and interior-accessory designs for shoppers building a coordinated look.'
        assign support = 'This hub keeps car products together while still letting shoppers narrow into seat covers and other interior accessory pages.'
      when 'bedding-sets'
        assign intro = 'Shop printed bedding set designs for bedroom refreshes, themed rooms, dorm decor, and giftable home style.'
        assign support = 'Representative BestPrintsCo bedding listings state that the set includes one duvet cover and two pillow cases; comforter, bed sheets, and pillow inserts are not included. Compare the artwork, selected size, product images, and price before checkout.'
      when 'hooded-blankets'
        assign intro = 'Browse hooded blanket designs for cozy movie nights, reading, lounging, and motif-led gift shopping.'
        assign support = 'Representative BestPrintsCo hooded blanket listings describe made-to-order construction, handcrafted finishing, premium suede polyester print for color vibrancy, and a cozy underside. Hooded blankets stay separate from bedding and standard blankets so you can compare the right product type.'
      when 'blankets'
        assign intro = 'Explore printed blanket designs for sofa lounging, reading in bed, cozy gifting, and theme-led home decor.'
        assign support = 'Representative BestPrintsCo blanket listings describe custom made-to-order construction, handcrafted finishing, premium suede polyester print for color vibrancy, and an ultra-soft cozy underside. Compare artwork, size options, and product images before checkout.'
      when 'beach-blankets'
        assign intro = 'Shop beach blanket designs for pool days, beach lounging, outdoor trips, and bright summer gift ideas.'
        assign support = 'Representative BestPrintsCo beach blanket listings describe custom made-to-order construction, handcrafted finishing, lightweight polyester/spandex blend, color-vibrant wide-format printing, and use around the beach or pool. Review the product page for item-specific details before ordering.'
      when 'all-home-products'
        assign intro = 'Browse BestPrintsCo home products across bedding, blankets, wall decor, and related home-gift collections.'
        assign support = 'This home hub helps shoppers move from broad inspiration into specific product families such as bedding sets, cozy blankets, hooded blankets, beach blankets, and wall tapestries.'
      when 'wall-tapestry'
        assign intro = 'Explore printed wall tapestry designs for dorm rooms, bedrooms, meditation corners, wall art, and giftable decor.'
        assign support = 'Representative BestPrintsCo tapestry listings describe custom made-to-order construction, handcrafted finishing, lightweight polyester material, color-vibrant wide-format printing, and possible uses such as wall art, picnic blanket, table cloth, curtain, or bedspread where stated on the product page.'
      when 'hoodies'
        assign intro = 'Shop printed hoodie designs for expressive everyday outfits, music-inspired looks, animal motifs, mandala art, and giftable apparel.'
        assign support = 'Representative BestPrintsCo hoodie listings include both cotton/poly blend styles and custom made-to-order polyester-blend styles with handcrafted finishing and high-definition heat-dye artwork. Compare the exact product page, size chart, fabric notes, color, and artwork before checkout.'
      when 'womens-hoodie-dresses'
        assign intro = 'Browse women’s hoodie dress designs from BestPrintsCo for statement apparel and gift discovery.'
        assign support = 'Hoodie dresses should stay separate from standard hoodies and T-shirts so shoppers compare the right garment type.'
        assign intro = 'Browse womens hoodie dress designs for statement outfits, cozy casual style, festival looks, and gift discovery.'
        assign support = 'Representative BestPrintsCo hoodie dress listings describe custom made-to-order construction, handcrafted finishing, premium polyester blend fabric, ultra-soft comfort, and high-definition heat-dye artwork for long-lasting color vibrancy. Compare the dress style, size, artwork, and product images before ordering.'
      when 't-shirts'
        assign intro = 'Explore printed T-shirt designs for coffee fans, music lovers, graphic motifs, funny gifts, and everyday casual outfits.'
        assign support = 'Representative BestPrintsCo T-shirt listings include Bella + Canvas 3001 styles with combed ring-spun cotton or cotton/poly blend notes, lightweight fabric, normal fit, and U.S. print/ship language where shown. Confirm the exact fabric, size chart, and product details on each product page.'
      when 'kids-clothing'
        assign intro = 'Browse kids clothing designs for youth hoodies, kids T-shirts, family-friendly motifs, and playful gift ideas.'
        assign support = 'Representative BestPrintsCo kids listings include youth hoodie and T-shirt sizing details, cotton/poly or polyester/cotton fabric notes on some products, and printed artwork. Review the product-page size chart carefully before ordering youth apparel.'
      when 'bags'
        assign intro = 'Shop printed bag designs for travel, daily carry, astrology gifts, floral style, dark academia looks, and motif-led accessories.'
        assign support = 'Representative BestPrintsCo bag listings include travel bags made with high-grade waterproof fabric and microfiber leather, a main compartment, interior pocket, portable belt, and adjustable shoulder strap. Some newer designs use book-shaped or specialty styling, so compare the exact product images and details before choosing.'
      else
        assign intro = 'Explore ' | append: title | append: ' from BestPrintsCo. Use the collection filters and product cards to compare available designs, styles, and options.'
        assign support = 'Review product images, available options, pricing, and policy links before ordering.'
    endcase
  -%}

  <section class="bls__section seo-collection-foundation">
    <div class="container">
      <div class="seo-collection-foundation__inner">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}

        <div class="seo-collection-foundation__copy rte">
          <p>{{ intro }}</p>
          <p>{{ support }}</p>
        </div>

        <nav class="seo-collection-foundation__links" aria-label="Related BestPrintsCo collections">
          <a href="/collections/footwear">Footwear</a>
          <a href="/collections/vegan-leather-boots">Vegan Leather Boots</a>
          <a href="/collections/running-shoes">Running Shoes</a>
          <a href="/collections/car-accessories">Car Accessories</a>
          <a href="/collections/car-seat-covers">Car Seat Covers</a>
          <a href="/collections/all-home-products">Home Products</a>
          <a href="/collections/bedding-sets">Bedding Sets</a>
          <a href="/collections/hooded-blankets">Hooded Blankets</a>
          <a href="/collections/hoodies">Hoodies</a>
          <a href="/collections/womens-hoodie-dresses">Hoodie Dresses</a>
          <a href="/collections/bags">Bags</a>
        </nav>

        <div class="seo-collection-foundation__themes">
          <h3>Shop by vibe and design theme</h3>
          <p>Looking for a specific mood, animal, or artwork style? Explore real BestPrintsCo catalog themes across footwear, home, apparel, car accessories, and gifts.</p>
          <nav class="seo-collection-foundation__links" aria-label="Shop BestPrintsCo by theme">
            <a href="/search?q=boho">Boho Designs</a>
            <a href="/search?q=mandala">Mandala Designs</a>
            <a href="/search?q=flower">Flower Designs</a>
            <a href="/search?q=cat">Cat Designs</a>
            <a href="/search?q=skull">Skull Designs</a>
            <a href="/search?q=elephant">Elephant Designs</a>
            <a href="/search?q=sea">Sea Designs</a>
            <a href="/search?q=dragon">Dragon Designs</a>
            <a href="/search?q=sunflower">Sunflower Designs</a>
            <a href="/search?q=sun">Sun Designs</a>
          </nav>
        </div>

        <div class="seo-collection-foundation__faq">
          <h3>Helpful shopping notes</h3>
          <details>
            <summary>{{ faq_1_q }}</summary>
            <p>{{ faq_1_a }}</p>
          </details>
          <details>
            <summary>{{ faq_2_q }}</summary>
            <p>{{ faq_2_a }}</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <style>
    .seo-collection-foundation {
      padding: 32px 0 48px;
    }

    .seo-collection-foundation__inner {
      max-width: 980px;
      margin: 0 auto;
    }

    .seo-collection-foundation__links {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 22px 0;
    }

    .seo-collection-foundation__links a {
      border: 1px solid rgba(17, 17, 17, 0.16);
      border-radius: 999px;
      padding: 8px 14px;
      text-decoration: none;
    }

    .seo-collection-foundation__faq details {
      border-top: 1px solid rgba(17, 17, 17, 0.12);
      padding: 14px 0;
    }

    .seo-collection-foundation__faq details:last-child {
      border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    }

    .seo-collection-foundation__faq summary {
      cursor: pointer;
      font-weight: 600;
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "SEO collection foundation",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop more BestPrintsCo collections"
    }
  ],
  "presets": [
    {
      "name": "SEO collection foundation"
    }
  ]
}
{% endschema %}
